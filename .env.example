# =============================================================================
# Community Hackathon Application - Environment Configuration Template
# =============================================================================
# Instructions:
# 1. For local development: copy this file to .env and fill in your values.
#    Never commit the actual .env file to Git.
# 2. For Render deployment: add these keys in your Render Dashboard -> Environment.
# =============================================================================

# Flask secret key - used to encrypt session cookies and CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# -----------------------------------------------------------------------------
# Database Configuration (MySQL)
# -----------------------------------------------------------------------------
# You can provide individual credentials:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=community_hackathon

# OR optionally provide a single cloud database URL (e.g., TiDB, Aiven, Railway):
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# SSL settings for cloud MySQL (TiDB Cloud, Aiven, etc.)
# If your cloud provider requires SSL/TLS, set these accordingly:
DB_SSL_DISABLED=false
DB_SSL_VERIFY_CERT=false

# -----------------------------------------------------------------------------
# Mail Configuration (Optional - for future email notifications)
# -----------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Debug mode: false in production, true only for local development
FLASK_DEBUG=false

# Session cookie security: set to true in production over HTTPS (Render enforces HTTPS)
# Leaving this false on plain HTTP prevents session cookies from being dropped.
SESSION_COOKIE_SECURE=false

# Server Port (Render sets this automatically via $PORT)
PORT=5000
